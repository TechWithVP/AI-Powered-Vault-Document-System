# =============================================================================
# AI-Powered Vault Document System — environment configuration
# Copy to `.env` and fill in secrets. Never commit the real `.env`.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=local                   # local | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
APP_LOG_JSON=true               # false => human-readable console logs
APP_API_KEYS=dev-key-change-me  # comma-separated; sent as `X-API-Key` header

# ---- PostgreSQL (pgvector) --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vault
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault

# ---- Redis (Celery broker + cache) ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BROKER_DB=0
REDIS_CACHE_DB=1

# ---- Document storage -------------------------------------------------------
STORAGE_BACKEND=local               # local | s3
STORAGE_LOCAL_PATH=/srv/app/data/documents

# ---- S3 (used when STORAGE_BACKEND=s3) --------------------------------------
S3_BUCKET=vault-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localstack:4566   # leave EMPTY to use real AWS S3
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_USE_SSL=false

# ---- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# ---- Ingestion tuning -------------------------------------------------------
INGEST_MAX_UPLOAD_MB=25
INGEST_CHUNK_TOKENS=350
INGEST_CHUNK_OVERLAP_RATIO=0.18
INGEST_EMBED_BATCH_SIZE=64

# ---- Retrieval / RAG tuning -------------------------------------------------
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.25         # below this => "not found in your documents"
RAG_HISTORY_TURNS=6

# ---- Rate limiting ----------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RAG_MIN_LEXICAL_RANK=0.02
